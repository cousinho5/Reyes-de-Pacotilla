{
  "name": "@reyes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servidor de Reyes de Pacotilla en Cloudflare Workers con D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply reyes --local",
    "db:migrate:remote": "wrangler d1 migrations apply reyes --remote",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@reyes/engine": "0.1.0",
    "hono": "^4.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "http_ece": "^1.2.1",
    "wrangler": "^4.151.0"
  }
}
